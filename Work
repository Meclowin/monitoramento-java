package monitoramento;
import java.util.ArrayList;
import java.util.Scanner;

public class Monitoramento {

    // ============================================================
    // CLASSE REGISTROSISTEMA
    // Guarda as informações de cada computador/servidor monitorado
    // ============================================================

    static class RegistroSistema {

        private String nome;
        private String status;
        private int cpu;
        private int tempoResposta;
        private int memoria;
        private String sistemaOperacional;
        private String ip;
        private int temperatura;

        // Construtor
        public RegistroSistema(
                String nome,
                String status,
                int cpu,
                int tempoResposta,
                int memoria,
                String sistemaOperacional,
                String ip,
                int temperatura) {

            this.nome = nome;
            this.status = status;
            this.cpu = cpu;
            this.tempoResposta = tempoResposta;
            this.memoria = memoria;
            this.sistemaOperacional = sistemaOperacional;
            this.ip = ip;
            this.temperatura = temperatura;
        }

        // ========================================================
        // GETTERS
        // ========================================================

        public String getNome() {
            return nome;
        }

        public String getStatus() {
            return status;
        }

        public int getCpu() {
            return cpu;
        }

        public int getTempoResposta() {
            return tempoResposta;
        }

        public int getMemoria() {
            return memoria;
        }

        public String getSistemaOperacional() {
            return sistemaOperacional;
        }

        public String getIp() {
            return ip;
        }

        public int getTemperatura() {
            return temperatura;
        }

        // ========================================================
        // SETTERS
        // ========================================================

        public void setNome(String nome) {
            this.nome = nome;
        }

        public void setStatus(String status) {
            this.status = status;
        }

        public void setCpu(int cpu) {
            this.cpu = cpu;
        }

        public void setTempoResposta(int tempoResposta) {
            this.tempoResposta = tempoResposta;
        }

        public void setMemoria(int memoria) {
            this.memoria = memoria;
        }

        public void setSistemaOperacional(String sistemaOperacional) {
            this.sistemaOperacional = sistemaOperacional;
        }

        public void setIp(String ip) {
            this.ip = ip;
        }

        public void setTemperatura(int temperatura) {
            this.temperatura = temperatura;
        }

        // ========================================================
        // MÉTODO PARA EXIBIR OS DADOS
        // ========================================================

        public void exibirInformacoes() {

            System.out.println("---------------------------------------------");
            System.out.println("Nome: " + nome);
            System.out.println("Status: " + status);
            System.out.println("CPU: " + cpu + "%");
            System.out.println("Memória: " + memoria + "%");
            System.out.println("Tempo de resposta: " + tempoResposta + " ms");
            System.out.println("Sistema operacional: " + sistemaOperacional);
            System.out.println("Endereço IP: " + ip);
            System.out.println("Temperatura: " + temperatura + " °C");
            System.out.println("---------------------------------------------");
        }

        // ========================================================
        // VERIFICA SE O SERVIDOR ESTÁ COM PROBLEMA
        // ========================================================

        public boolean estaComProblema() {

            if (status.equalsIgnoreCase("OFFLINE")) {
                return true;
            }

            if (cpu >= 85) {
                return true;
            }

            if (memoria >= 95) {
                return true;
            }

            if (tempoResposta >= 300) {
                return true;
            }

            if (temperatura >= 75) {
                return true;
            }

            return false;
        }
    }

    // ============================================================
    // LISTA QUE ARMAZENA OS COMPUTADORES
    // ============================================================

    static ArrayList<RegistroSistema> registros = new ArrayList<>();

    static Scanner scanner = new Scanner(System.in);

    // ============================================================
    // MÉTODO PRINCIPAL
    // ============================================================

    public static void main(String[] args) {

        carregarDadosIniciais();

        int opcao;

        do {

            exibirMenu();

            opcao = lerInteiro("Escolha uma opção: ");

            switch (opcao) {

                case 1:
                    cadastrarSistema();
                    break;

                case 2:
                    listarSistemas();
                    break;

                case 3:
                    buscarSistema();
                    break;

                case 4:
                    alterarStatus();
                    break;

                case 5:
                    atualizarMonitoramento();
                    break;

                case 6:
                    listarProblemas();
                    break;

                case 7:
                    gerarRelatorio();
                    break;

                case 8:
                    excluirSistema();
                    break;

                case 9:
                    System.out.println();
                    System.out.println("=============================================");
                    System.out.println("Sistema encerrado.");
                    System.out.println("Obrigado por utilizar o Monitoramento!");
                    System.out.println("=============================================");
                    break;

                default:
                    System.out.println();
                    System.out.println("Opção inválida!");
                    break;
            }

        } while (opcao != 9);

        scanner.close();
    }

    // ============================================================
    // MENU PRINCIPAL
    // ============================================================

