    // ============================================================
    // CADASTRAR SISTEMA
    // ============================================================

    public static void cadastrarSistema() {

        System.out.println();
        System.out.println("=============================================");
        System.out.println("           CADASTRO DE SISTEMA");
        System.out.println("=============================================");

        String nome = lerTexto("Nome do sistema: ");

        // Verifica se já existe
        if (procurarPorNome(nome) != null) {

            System.out.println();
            System.out.println("Já existe um sistema com esse nome.");
            return;
        }

        String status = lerTexto("Status (ONLINE/OFFLINE): ");

        int cpu = lerPercentual("Uso da CPU (%): ");

        int memoria = lerPercentual("Uso da memória (%): ");

        int tempoResposta =
                lerInteiroPositivo("Tempo de resposta (ms): ");

        String sistemaOperacional =
                lerTexto("Sistema operacional: ");

        String ip =
                lerTexto("Endereço IP: ");

        int temperatura =
                lerInteiroPositivo("Temperatura (°C): ");

        RegistroSistema novoSistema =
                new RegistroSistema(
                        nome,
                        status,
                        cpu,
                        tempoResposta,
                        memoria,
                        sistemaOperacional,
                        ip,
                        temperatura
                );

        registros.add(novoSistema);

        System.out.println();
        System.out.println("Sistema cadastrado com sucesso!");
    }

    // ============================================================
    // LISTAR TODOS OS SISTEMAS
    // ============================================================

    public static void listarSistemas() {

        System.out.println();
        System.out.println("=============================================");
        System.out.println("           SISTEMAS MONITORADOS");
        System.out.println("=============================================");

        if (registros.isEmpty()) {

            System.out.println("Nenhum sistema cadastrado.");

            return;
        }

        for (int i = 0; i < registros.size(); i++) {

            System.out.println();
            System.out.println("Sistema #" + (i + 1));

            registros.get(i).exibirInformacoes();
        }
    }

    // ============================================================
    // BUSCAR SISTEMA
    // ============================================================

    public static void buscarSistema() {

        System.out.println();
        System.out.println("=============================================");
        System.out.println("             BUSCAR SISTEMA");
        System.out.println("=============================================");

        String nome = lerTexto("Digite o nome do sistema: ");

        RegistroSistema sistema = procurarPorNome(nome);

        if (sistema == null) {

            System.out.println();
            System.out.println("Sistema não encontrado.");

        } else {

            System.out.println();
            System.out.println("Sistema encontrado:");

            sistema.exibirInformacoes();
        }
    }

    // ============================================================
    // PROCURAR POR NOME
    // ============================================================

    public static RegistroSistema procurarPorNome(String nome) {

        for (RegistroSistema sistema : registros) {

            if (sistema.getNome().equalsIgnoreCase(nome)) {

                return sistema;
            }
        }

        return null;
    }

    // ============================================================
    // ALTERAR STATUS
    // ============================================================

    public static void alterarStatus() {

        System.out.println();
        System.out.println("=============================================");
        System.out.println("             ALTERAR STATUS");
        System.out.println("=============================================");

        String nome = lerTexto("Nome do sistema: ");

        RegistroSistema sistema = procurarPorNome(nome);

        if (sistema == null) {

            System.out.println("Sistema não encontrado.");

            return;
        }

        System.out.println();
        System.out.println("Status atual: " + sistema.getStatus());

        String novoStatus =
                lerTexto("Novo status (ONLINE/OFFLINE): ");

        sistema.setStatus(novoStatus);

        System.out.println();
        System.out.println("Status atualizado com sucesso!");
    }

    // ============================================================
    // ATUALIZAR MONITORAMENTO
    // ============================================================

    public static void atualizarMonitoramento() {

        System.out.println();
        System.out.println("=============================================");
        System.out.println("        ATUALIZAR MONITORAMENTO");
        System.out.println("=============================================");

        String nome = lerTexto("Nome do sistema: ");

        RegistroSistema sistema = procurarPorNome(nome);

        if (sistema == null) {

            System.out.println("Sistema não encontrado.");

            return;
        }

        System.out.println();
        System.out.println("Sistema encontrado.");
        System.out.println();

        int cpu =
                lerPercentual("Novo uso da CPU (%): ");

        int memoria =
                lerPercentual("Novo uso da memória (%): ");

        int tempo =
                lerInteiroPositivo("Novo tempo de resposta (ms): ");

        int temperatura =
                lerInteiroPositivo("Nova temperatura (°C): ");

        sistema.setCpu(cpu);
        sistema.setMemoria(memoria);
        sistema.setTempoResposta(tempo);
        sistema.setTemperatura(temperatura);

        System.out.println();
        System.out.println("Monitoramento atualizado!");
    }

    // ============================================================
    // LISTAR SISTEMAS COM PROBLEMAS
    // ============================================================

    public static void listarProblemas() {

        System.out.println();
        System.out.println("=============================================");
        System.out.println("       SISTEMAS COM PROBLEMAS");
        System.out.println("=============================================");

        boolean encontrouProblema = false;

        for (RegistroSistema sistema : registros) {

            if (sistema.estaComProblema()) {

                sistema.exibirInformacoes();

                encontrouProblema = true;
            }
        }

        if (!encontrouProblema) {

            System.out.println();
            System.out.println("Nenhum problema encontrado.");
        }
    }

    // ============================================================
    // GERAR RELATÓRIO
    // ============================================================

    public static void gerarRelatorio() {

        System.out.println();
        System.out.println("=============================================");
        System.out.println("             RELATÓRIO GERAL");
        System.out.println("=============================================");

        int total = registros.size();

        int online = 0;
        int offline = 0;
        int problemas = 0;

        int somaCpu = 0;
        int somaMemoria = 0;
        int somaTempo = 0;

        for (RegistroSistema sistema : registros) {

            if (sistema.getStatus().equalsIgnoreCase("ONLINE")) {

                online++;

            } else {

                offline++;
            }

            if (sistema.estaComProblema()) {

                problemas++;
            }

            somaCpu += sistema.getCpu();

            somaMemoria += sistema.getMemoria();

            somaTempo += sistema.getTempoResposta();
        }

        System.out.println();

        System.out.println("Total de sistemas: " + total);

        System.out.println("Sistemas online: " + online);

        System.out.println("Sistemas offline: " + offline);

        System.out.println("Sistemas com problemas: " + problemas);

        if (total > 0) {

            double mediaCpu =
                    (double) somaCpu / total;

            double mediaMemoria =
                    (double) somaMemoria / total;

            double mediaTempo =
                    (double) somaTempo / total;

            System.out.printf(
                    "Média de CPU: %.2f%%%n",
                    mediaCpu
            );

            System.out.printf(
                    "Média de memória: %.2f%%%n",
                    mediaMemoria
            );

            System.out.printf(
                    "Média de resposta: %.2f ms%n",
                    mediaTempo
            );
        }

        System.out.println();
        System.out.println("=============================================");
    }

    // ============================================================
    // EXCLUIR SISTEMA
    // ============================================================

    public static void excluirSistema() {

        System.out.println();
        System.out.println("=============================================");
        System.out.println("             EXCLUIR SISTEMA");
        System.out.println("=============================================");

        String nome = lerTexto("Nome do sistema: ");

        RegistroSistema sistema = procurarPorNome(nome);

        if (sistema == null) {

            System.out.println("Sistema não encontrado.");

            return;
        }

        System.out.println();
        System.out.println("Sistema encontrado:");

        sistema.exibirInformacoes();

        String confirmacao =
                lerTexto("Deseja realmente excluir? (S/N): ");

        if (confirmacao.equalsIgnoreCase("S")) {

            registros.remove(sistema);

            System.out.println();
            System.out.println("Sistema excluído com sucesso!");

        } else {

            System.out.println();
            System.out.println("Operação cancelada.");
        }
    }

