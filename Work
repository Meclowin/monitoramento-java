        System.out.println("2 - Listar sistemas");
        System.out.println("3 - Buscar sistema");
        System.out.println("4 - Alterar status");
        System.out.println("5 - Atualizar monitoramento");
        System.out.println("6 - Listar sistemas com problemas");
